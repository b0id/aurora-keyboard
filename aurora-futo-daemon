#!/usr/bin/env bash
# Launcher for FUTO Neural Swipe Daemon inside the ydotool-box container
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if command -v distrobox &>/dev/null; then
    exec distrobox enter ydotool-box -- python3 "$SCRIPT_DIR/aurora_keyboard/swipe/futo_daemon.py" "$@"
else
    exec python3 "$SCRIPT_DIR/aurora_keyboard/swipe/futo_daemon.py" "$@"
fi
